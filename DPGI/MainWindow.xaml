<Window x:Class="DPGI.MainWindow"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:local="clr-namespace:DPGI"
         mc:Ignorable="d"
         Title="TextEditor" Height="300" Width="500">
    <Grid ShowGridLines="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" BorderBrush="#FFCBBEBE" BorderThickness="2" CornerRadius="10">
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Button Width="50" Height="50">
                    <Image ToolTip="Open" Source="/images/Open.png"/>
                </Button>
                <Button Width="50" Height="50">
                    <Image ToolTip="Clear" Source="/images/Clear.png"/>
                </Button>
                <Button Width="50" Height="50">
                    <Image ToolTip="Copy" Source="/images/Copy.png" />

                </Button>
                <Button Width="50" Height="50">
                    <Image ToolTip="Paste" Source="/images/Paste.png"/>
                </Button>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" BorderBrush="#FFCBBEBE" BorderThickness="2" CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                </Grid.RowDefinitions>
                <TextBox Grid.Row="0" Margin="10" VerticalScrollBarVisibility="Visible"></TextBox>
                <DockPanel Grid.Row="1" Margin="10">
                    <Button DockPanel.Dock="Bottom" Width="30">OK</Button>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>