<Page x:Class="BaldaGame.Views.PageGame"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:cmd="clr-namespace:BaldaGame.Commands"
      Title="Гра">
    <DockPanel>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Дія">
                <MenuItem Header="Скасувати" Command="cmd:DataCommands.Undo" />
                <Separator/>
                <MenuItem Header="Нова гра"  Command="cmd:DataCommands.New" />
                <MenuItem Header="Зберегти"  Command="cmd:DataCommands.Save" />
            </MenuItem>
        </Menu>

        <ToolBar DockPanel.Dock="Top">
            <Button Command="cmd:DataCommands.Undo"   ToolTip="Скасувати">
                <Image Source="/Images/Undo.png" Width="16" Height="16"/>
            </Button>
            <Button Command="cmd:DataCommands.New"    ToolTip="Нова гра">
                <Image Source="/Images/New.png" Width="16" Height="16"/>
            </Button>
            <Button Command="cmd:DataCommands.Save"   ToolTip="Зберегти">
                <Image Source="/Images/Save.png" Width="16" Height="16"/>
            </Button>
        </ToolBar>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Expander Header="Поле гри" IsExpanded="True" Grid.Column="0" Margin="10">
                <UniformGrid x:Name="BoardGrid" Rows="5" Columns="5" Margin="10"/>
            </Expander>

            <StackPanel Grid.Column="1" Margin="10" VerticalAlignment="Top" HorizontalAlignment="Left">
                <TextBlock Text="Хід: " FontSize="16"/>
                <TextBlock Text="{Binding CurrentPlayer}" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                <TextBlock Text="Нова літера:"/>
                <TextBox Text="{Binding NewLetter, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="0,5" MaxLength="1"/>
                <Button Content="Помістити літеру" Command="{Binding PlaceLetterCommand}" Width="150" Margin="0,5"/>

                <TextBlock Text="Рахунок:" FontSize="16" Margin="0,15,0,5"/>
                <TextBlock Text="{Binding PlayerOneScore, StringFormat=Гравець 1: {0}}" FontSize="14"/>
                <TextBlock Text="{Binding PlayerTwoScore, StringFormat=Гравець 2: {0}}" FontSize="14"/>
                <Button Content="Скинути гру" Command="{Binding ResetGameCommand}" Width="150" Margin="0,10"/>

                <TextBlock Text="{Binding WinnerText}" FontSize="16" FontWeight="Bold" Margin="0,20,0,0"/>
            </StackPanel>
        </Grid>

    </DockPanel>
</Page>
