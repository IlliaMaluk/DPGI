<Window x:Class="lab5_fixed.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Довідник студентів" Height="450" Width="800">
    <Grid>
        <TabControl>
            <TabItem Header="Групи">
                <DataGrid x:Name="dgGroups" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Код групи"
                                Binding="{Binding GroupCode}"/>
                        <DataGridTextColumn Header="Найменування групи"
                                Binding="{Binding GroupName}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Студенти">
                <DataGrid x:Name="dgStudents" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Номер залікової"
                        Binding="{Binding StudentBookNumber}"/>
                        <DataGridTextColumn Header="Група"
                        Binding="{Binding GroupName}"/>
                        <DataGridTextColumn Header="Адреса"
                        Binding="{Binding Address}"/>
                    </DataGrid.Columns>
                </DataGrid>


            </TabItem>
            <TabItem Header="Запити">
                <DataGrid x:Name="dgQuery" AutoGenerateColumns="True" IsReadOnly="True"/>
            </TabItem>
            <TabItem Header="Пошук">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,10">
                        <TextBlock Text="Номер залікової:" VerticalAlignment="Center"/>
                        <TextBox x:Name="tbSearchBookNumber"
                                 Width="100"
                                 Margin="5,0"/>
                        <Button Content="Шукати"
                                Click="BtnSearch_Click"
                                Padding="10,2"/>
                    </StackPanel>

                    <DataGrid x:Name="dgSearch"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Номер залікової"
                                                Binding="{Binding StudentBookNumber}"/>
                            <DataGridTextColumn Header="Група"
                                                Binding="{Binding GroupName}"/>
                            <DataGridTextColumn Header="Адреса"
                                                Binding="{Binding Address}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
